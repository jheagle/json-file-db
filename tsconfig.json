{
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.*"],
  "compilerOptions": {
    "noImplicitAny": false,
    "target": "es2020",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "declaration": true,
    "outDir": "dist",
    "declarationMap": true,
    "strictNullChecks": false,
    "types": []
  }
}
