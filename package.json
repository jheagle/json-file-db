{
  "name": "json-fs-query",
  "version": "1.1.0",
  "description": "Use json files to manage and read data.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "unpkg": "browser/jsonFsQuery.min.js",
  "jsdelivr": "browser/jsonFsQuery.min.js",
  "files": [
    "dist",
    "browser"
  ],
  "scripts": {
    "build": "gulp build",
    "dev": "gulp",
    "docs": "gulp docs",
    "publish:bundle": "gulp copyFiles",
    "release": "release-it",
    "release:dry-run": "release-it --dry-run",
    "sass": "gulp sass",
    "test": "gulp testFull",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:quick": "gulp testQuick",
    "watch": "gulp watchFull",
    "watch:test": "gulp watchTest",
    "lint": "gulp lint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jheagle/json-file-db.git"
  },
  "keywords": [
    "database",
    "filesystem",
    "json",
    "data"
  ],
  "author": "Joshua Heagle <joshuaheagle@gmail.com>",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/jheagle/json-file-db/issues"
  },
  "homepage": "https://github.com/jheagle/json-file-db#readme",
  "devDependencies": {
    "gulp": "^5.0.1",
    "js-build-tools": "^6.6.0",
    "release-it": "^21.1.1",
    "test-filesystem": "^2.0.2",
    "typedoc": "^0.28.20"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.4",
    "browser-or-node": "^3.0.0",
    "commander": "^15.0.0",
    "core-js": "^3.51.0",
    "prettytable": "^2.0.0",
    "si-funciona": "^2.8.0"
  },
  "standard": {
    "env": [
      "jest"
    ]
  },
  "allowScripts": {
    "core-js": false,
    "core-js-pure": false,
    "@parcel/watcher": false,
    "unrs-resolver": false
  }
}
