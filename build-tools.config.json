{
  "browser": {
    "enabled": false,
    "name": "jsonFileDb"
  },
  "dist": {
    "main": "dist/index.js"
  },
  "docs": {
    "enabled": true,
    "from": "src/data",
    "index": "MAIN.md",
    "to": "../joshuaheagle.local/projects/json-file-db/docs"
  },
  "typescript": {
    "config": "tsconfig.json",
    "enabled": true
  },
  "test": {
    "options": {
      "testMatch": [
        "**/?(*.)+(spec|test).js?(x)"
      ]
    },
    "path": "src",
    "watch": "src/**/*.[jt]s"
  },
  "relativePath": "http://joshuaheagle.local/projects/workout-planner",
  "databasePath": "database/"
}
