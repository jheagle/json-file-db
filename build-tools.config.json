{
  "browser": {
    "enabled": true,
    "name": "jsonFsQuery",
    "ignore": ["fs", "fs/promises"]
  },
  "copyFiles": [
    {
      "from": "browser/*.js",
      "to": "../joshuaheagle.local/projects/json-file-db/browser"
    }
  ],
  "dist": {
    "main": "dist/index.js"
  },
  "docs": {
    "enabled": true,
    "from": "src/data",
    "index": "MAIN.md",
    "to": "../joshuaheagle.local/projects/json-file-db/docs"
  },
  "typescript": {
    "config": "tsconfig.json",
    "enabled": true
  },
  "test": {
    "options": {
      "testMatch": [
        "**/?(*.)+(spec|test).js?(x)"
      ]
    },
    "path": "src",
    "watch": "src/**/*.[jt]s"
  },
  "relativePath": "http://joshuaheagle.local/projects/workout-planner",
  "databasePath": "database/"
}
